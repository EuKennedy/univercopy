# UniverCopy — env reference. Copy to .env.local (dev) or set in Coolify (prod).
# Generate strong secrets with: openssl rand -hex 64

# ----- Domain & URLs -----
APP_DOMAIN=univercopy.com
FRONTEND_URL=https://app.univercopy.com
LANDING_URL=https://univercopy.com
API_URL=https://api.univercopy.com
COOKIE_DOMAIN=.univercopy.com

# ----- Database -----
DATABASE_URL=postgres://univercopy:CHANGE_ME@db:5432/univercopy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=univercopy
POSTGRES_DB=univercopy

# ----- Redis (Sidekiq + cache) -----
REDIS_URL=redis://:CHANGE_ME@cache:6379/0
REDIS_PASSWORD=CHANGE_ME

# ----- Rails -----
RAILS_ENV=production
SECRET_KEY_BASE=CHANGE_ME_64_HEX
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
SIDEKIQ_CONCURRENCY=10

# ----- Better Auth (Next.js) -----
BETTER_AUTH_SECRET=CHANGE_ME_64_HEX
BETTER_AUTH_TRUSTED_ORIGINS=https://app.univercopy.com,https://univercopy.com

# ----- Encryption for tenant credentials (Woo/Shopify/etc keys) -----
TENANT_CREDENTIALS_KEY=CHANGE_ME_64_HEX

# ----- Anthropic / AI -----
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
CLAUDE_DEFAULT_MODEL=auto

# ----- MinIO (S3-compatible storage) -----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=univer-copy-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# ----- Email (Resend) -----
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=suporte@univercopy.com
RESEND_WEBHOOK_SECRET=CHANGE_ME

# ----- Billing gateway (external, you'll provide spec) -----
BILLING_WEBHOOK_SECRET=CHANGE_ME
BILLING_GATEWAY_URL=

# ----- Observability -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----- CORS / Trusted origins -----
CORS_ALLOWED_ORIGINS=https://app.univercopy.com,https://univercopy.com

# ----- Feature flags -----
AUTOPROVISION_WORKSPACE_ID=
